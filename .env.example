# MongoDB Atlas connection string (include the database name)
MONGODB_URI=

# Long random string used to sign admin session tokens (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Public base URL of the site (sitemap, canonical URLs, upload same-origin check)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP for contact form email notifications (optional; inquiries are always saved in admin)
# For Gmail use an App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
INQUIRY_NOTIFY_TO=
